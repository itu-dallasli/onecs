ONECS_ENV=development
ONECS_TEST_GOD_MODE=false
ONECS_SECRET_KEY=replace-with-long-random-secret
ONECS_ENCRYPTION_KEY=generate-a-fernet-key-before-saving-integration-secrets
DATABASE_URL=postgresql://onecs@127.0.0.1:55432/onecs
POSTGRES_DB=onecs
POSTGRES_USER=onecs
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
ONECS_DEMO_PASSWORD=choose-a-local-demo-password
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
ONECS_ALLOWED_INTEGRATION_HOSTS=localhost,127.0.0.1
ONECS_ALLOW_PRIVATE_INTEGRATION_HOSTS=localhost,127.0.0.1
# Optional PEM CA bundles maintained by deployment; TLS verification stays required.
ONECS_LDAP_CA_FILE=
ONECS_AI_CA_FILE=
# Private record attachments. Scanner returns 0 clean, 1 infected, other = pending.
# Example after installing a scanner: clamscan --no-summary
ONECS_UPLOAD_SCANNER_COMMAND=
ONECS_UPLOAD_ALLOW_UNSCANNED=false
# Optional absolute private storage root (default .runtime/private-uploads).
# ONECS_UPLOAD_ROOT=/srv/onecs/private-uploads
